# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any Postgres works. The quickest free option is Prisma Postgres:
#   npm run db:create
# Then paste the connection string it prints (and claim the database so it is
# not deleted after 24 hours).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication (server-side)
# ---------------------------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="https://korora.joshuasoong.studio"

# Optional extra origins allowed to talk to the auth API (comma separated).
WEB_ORIGIN="https://korora.joshuasoong.studio"

# ---------------------------------------------------------------------------
# Demo
# ---------------------------------------------------------------------------
# The login form is prefilled with these credentials when demo mode is on.
# The same values are used by `npm run db:seed`.
VITE_DEMO_MODE="true"
VITE_DEMO_FIRST_NAME="Amelie"
VITE_DEMO_LAST_NAME="Lacroix"
VITE_DEMO_PASSWORD="demo"

# ---------------------------------------------------------------------------
